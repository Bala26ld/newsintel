# Copy to .env. Keys are read from the environment only; never commit real keys.
NEWSINTEL_DATABASE_URL=sqlite:///./newsintel.db         # or postgresql+psycopg://newsintel:newsintel@localhost:5432/newsintel
NEWSINTEL_BUS=memory                                     # memory | redis
NEWSINTEL_REDIS_URL=redis://localhost:6379/0
NEWSINTEL_CONTACT_EMAIL=you@example.com                  # goes into the EDGAR User-Agent, as its fair-access policy asks
NEWSINTEL_API_KEYS_READER=dev-reader-key
NEWSINTEL_API_KEYS_REVIEWER=dev-reviewer-key
NEWSINTEL_RECORD_FIXTURES=true
# Model slots (optional; the deterministic path runs without them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEWSINTEL_FAST_MODEL=
NEWSINTEL_STRONG_MODEL=
NEWSINTEL_STRONG_BASE_URL=
